    "verificar:marcas": "node --env-file=.env.local scripts/verificar-marcas.mjs",
    "verificar:resumo": "node --env-file=.env.local scripts/verificar-resumo.mjs",
    "verificar:especificacoes": "node --env-file=.env.local scripts/verificar-especificacoes.mjs",
    "verificar:destaques": "node --env-file=.env.local scripts/verificar-destaques.mjs",
    "verificar:vitrine": "node --env-file=.env.local scripts/verificar-vitrine.mjs",
    "verificar:afiliado": "node --env-file=.env.local scripts/verificar-afiliado.mjs",
    "verificar:apresentacao": "node --env-file=.env.local scripts/verificar-apresentacao.mjs",
    "verificar:frete": "node --env-file=.env.local scripts/verificar-frete.mjs",
