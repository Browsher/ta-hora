# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha com os valores REAIS da sua loja.
# `.env.local` é ignorado pelo git (ver .gitignore) — NUNCA commite o token.
# O token é lido APENAS no servidor (lib/shopify/client.ts usa `server-only`);
# nunca é exposto ao browser. Não use prefixo NEXT_PUBLIC_ nestas variáveis.

# Domínio da loja Shopify (formato: sua-loja.myshopify.com)
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com

# Token de acesso da Storefront API (público de leitura, mas mantido server-side).
# Scopes necessários no app da Shopify:
#   - unauthenticated_read_product_listings
#   - unauthenticated_read_product_inventory   (para refletir estoque)
SHOPIFY_STOREFRONT_TOKEN=coloque_o_token_da_storefront_aqui

# Versão da Storefront API. Opcional — default "2026-01" no código.
# A Shopify suporta cada versão por ~1 ano; versões fora da janela param de
# responder. Suportadas hoje: 2025-07, 2025-10, 2026-01, 2026-04 (default da
# Shopify), 2026-07. Deixe comentado para seguir o default do código.
#SHOPIFY_STOREFRONT_API_VERSION=2026-01
