# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha com os valores REAIS da sua loja.
# `.env.local` é ignorado pelo git (ver .gitignore) — NUNCA commite o token.
# O token é lido APENAS no servidor (lib/shopify/client.ts usa `server-only`);
# nunca é exposto ao browser. Não use prefixo NEXT_PUBLIC_ nestas variáveis.

# Domínio da loja Shopify (formato: sua-loja.myshopify.com)
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com

# Token de acesso da Storefront API (público de leitura, mas mantido server-side).
# Scopes necessários no app da Shopify:
#   - unauthenticated_read_product_listings
#   - unauthenticated_read_product_inventory   (para refletir estoque)
SHOPIFY_STOREFRONT_TOKEN=coloque_o_token_da_storefront_aqui

# Versão da Storefront API. Opcional — default "2026-01" no código.
# A Shopify suporta cada versão por ~1 ano; versões fora da janela param de
# responder. Suportadas hoje: 2025-07, 2025-10, 2026-01, 2026-04 (default da
# Shopify), 2026-07. Deixe comentado para seguir o default do código.
#SHOPIFY_STOREFRONT_API_VERSION=2026-01

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# ⚠️ AQUI O PREFIXO `NEXT_PUBLIC_` É CORRETO — e é a exceção à regra do topo
# deste arquivo. Aquela proibição vale para o TOKEN DA SHOPIFY, que não pode
# vazar. O Measurement ID do GA4 é público por natureza: ele aparece na URL do
# script do gtag em toda página. Não há segredo a proteger aqui.
#
# ⚠️ `NEXT_PUBLIC_*` é substituída no BUILD, não em runtime. Configurar na Vercel
# depois do deploy não tem efeito nenhum até o próximo build.
#
# Sem esta variável o site funciona idêntico e simplesmente não mede nada
# (`ATIVO` em lib/analytics/gtag.ts fica false e nenhum script é injetado).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Escape para validar eventos no DebugView do GA4 a partir do localhost.
# DESLIGADO por padrão, e é de propósito: sem isto, todo `npm run dev` com hot
# reload despeja page_view e add_to_cart de teste na propriedade real, e o filtro
# de IP interno não segura (IP residencial muda).
# Deixe comentado. Ligue só durante uma sessão de verificação.
#NEXT_PUBLIC_GA4_DEBUG=1
